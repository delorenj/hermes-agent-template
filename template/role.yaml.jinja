# Hermes agent role manifest.  Tracked in the PROJECT repository.
# The agent's actual state (memory, sessions, evolving SOUL) lives in the
# ignored local runtime. This file is the immutable contract for this role.

repo: {{ target_repo | tojson }}
role: {{ role | tojson }}
agent_id: {{ agent_id | tojson }}
display_name: {{ display_name | tojson }}
purpose: {{ agent_purpose | tojson }}

# Personality tone -- a key in the flume repo's `roles/_tones.yaml`.
#
# PERSISTED, and that is the point. Tone used to be a hire-time-only copier
# variable that was written into SOUL.md prose and then forgotten, so
# re-composing a deployed agent had no way to reproduce the operator's choice
# and would silently normalise the whole fleet to `direct`. Roles provisioned
# before this field existed are recovered by recognising the tone paragraph
# already in their soul; every role provisioned from here carries its answer.
soul_tone: {{ soul_tone | tojson }}
{%- if agent_identity %}

# Named agent. `name` is WHO this agent is; agent_id/profile below are only the
# POST it currently holds. The name, the personal Hindsight bank and the chat
# identity travel with the agent if it changes posts; the repo, board and
# project memory stay with the post. 10-hermes-profile.sh pins the profile's
# identity memory to write_bank and 80-registry.sh projects this block into
# agents.<agent_id>.identity / hindsight.* (validated by .scripts/lib/role-identity.py).
# Posts are unnamed and carry no identity block at all.
identity:
  name: {{ agent_identity | tojson }}
  write_bank: {{ ("agent-" ~ agent_identity) | tojson }}
  # Read-only history the agent may recall explicitly (write_bank is implied).
  recall_banks:
    - {{ ("agent-" ~ agent_identity) | tojson }}
{%- endif %}

# Process-local gateway inference target (empty = inherit from shared
# ~/.hermes/config.yaml). key_env is a variable NAME only; its secret value is
# injected at runtime and must never be written here.
model:
  provider: {{ model_provider | tojson }}
  name: {{ model_name | tojson }}
  base_url: {{ model_base_url | tojson }}
  api_mode: {{ model_api_mode | tojson }}
  key_env: {{ model_key_env | tojson }}

# Hermes profile name. ~/.hermes/profiles/<name> is a REAL directory managed by
# `flume remediate hermes.runtime-singleton`: shared config/auth/skills link to the
# fleet root while role-owned state links into ./runtime. Never replace the
# named profile with a symlink to runtime.
profile: {{ agent_id | tojson }}

# Telegram bot identity (one bot per agent — see docs/architecture.md).
telegram:
  provisioning_status: "deferred"
  bot_username: {{ bot_handle | tojson }}
  bot_id: ""

# Slack is opt-in. Credentials live in 1Password and the profile maps only
# op:// references; this block records safe state and auth.test identity.
slack:
  provisioning_status: "deferred"
  team_id: ""
  team_name: ""
  bot_user_id: ""
  bot_id: ""
  bot_username: ""

# Ticket-provider binding (linear | plane | trello).
# The heartbeat reconciliation pass talks ONLY to this via .scripts/lib/ticket-provider.sh;
# swapping providers is a one-line change here. Filled in by 42-ticket-provider.sh.
ticket_provider:
  name: {{ ticket_provider | tojson }}
  board_id: ""
{%- if ticket_provider == 'linear' %}
  team: ""        # Linear team key, e.g. DEL  (set before first sentinel run)
  project: ""     # optional Linear project name to scope milestones/issues
{%- elif ticket_provider == 'plane' %}
  workspace: {{ plane_workspace | tojson }}
  project: ""     # Plane project uuid (set by 42-ticket-provider.sh)
{%- elif ticket_provider == 'trello' %}
  board: ""       # Trello board id (set by 42-ticket-provider.sh)
{%- endif %}
  timezone: ""    # IANA project calendar; empty = TICKET_PROVIDER_TIMEZONE, TZ, then host-local
  # Optional normalized-state name overrides for non-standard boards.
  backlog: ""     # e.g. "Backlog"
  unstarted: ""   # e.g. "Todo"
  started: ""     # e.g. "In Progress"
  in_review: ""   # e.g. "In Review"
  completed: ""   # e.g. "Done"
  cancelled: ""   # e.g. "Cancelled"
  # Optional extended transition targets. A role enables one by naming its
  # lane here; left out, `tp transition <id> <state>` refuses it with
  # "ticket_provider.<state> is required" (Plane defaults awaiting_decision to
  # "Needs Attention"). Aliases: needs_attention/waiting_reply ->
  # awaiting_decision, ready_for_e2e -> e2e_testing.
  # awaiting_decision: ""        # started group, e.g. "Awaiting Decision"
  # e2e_testing: ""              # started group, e.g. "E2E Testing & QA"
  # ready_for_documentation: ""  # started group, e.g. "Ready for Documentation"
  # needs_re_evaluation: ""      # unstarted group, e.g. "Needs Re-evaluation"

# Board-reconciliation knobs for the heartbeat sentinel pass.
reconcile:
  enabled: {{ reconcile_enabled | tojson }}  # default on for PM operation; set false as the explicit checkpoint-only opt-out
  explicit_opt_out: {% if reconcile_enabled %}false{% else %}true{% endif %}  # distinguishes operator choice from the legacy default-off manifest
  grace_hours: 0             # 0 = no human-approval wait (adversarially-reviewed review-lane = done); set >0 to require a wait
  auto_review: true          # autonomous adversarial review (act, do not wait) on/off

# Plane project (1:1 with this agent) — retained for fleet-registry back-compat.
plane:
  # Empty -> resolved from ~/.config/hermes-agent-template/config.toml [plane].workspace
  workspace: {{ plane_workspace | tojson }}
  # identifier is set by .scripts/42-ticket-provider.sh after creation (plane only)
  identifier: ""

# Bloodbank ingress is owned by one fleet-shared Hermes gateway. The gateway
# reads the fleet registry and routes canonical commands by target_agent_id;
# this profile does not install its own NATS consumer or inbox bridge.
bloodbank:
  # Activation gate: default on. An absent key also means enabled; set this to
  # false (the strict YAML boolean) to quarantine the agent from dispatch.
  enabled: true
  gateway_scope: fleet
  target_agent_id: {{ agent_id | tojson }}
  producer: {{ ("hermes-agent:" ~ agent_id) | tojson }}

# Reconciled by 70-systemd.sh. These are lifecycle observations, not desired
# state: gateway stays deferred until a dedicated chat credential is verified;
# heartbeat is independent and drives PM board reconciliation by default.
service_state:
  gateway: "pending"
  heartbeat: "pending"

# Pure-local role-owned state. HERMES_HOME itself is the named profile directory
# above; the legacy GitHub identity remains metadata-only for locating old
# archives, and provisioning never creates or attaches a submodule.
runtime:
  # Empty owner -> resolved from config.toml [github].runtime_repo_owner.
  github_owner: {{ runtime_repo_owner | tojson }}
  github_repo: {{ runtime_repo | tojson }}
  local_path: "./runtime"
  checkpoint:
    cadence: "disabled"
    on_session_end: false

# Provenance — managed by the template, do not hand-edit.
provisioned_at: "{{ '%Y-%m-%dT%H:%M:%SZ' | strftime }}"
provisioned_by: hermes-agent-template
