#!/usr/bin/env bash
# Launcher for {{ agent_id }}. Resolves HERMES_HOME to the runtime submodule
# and execs the shared fleet Hermes binary configured in ~/.hermes/fleet.env.

set -euo pipefail

ROLE_DIR="$(cd "$(dirname "$0")" && pwd)"
HERMES_HOME="$ROLE_DIR/runtime"

FLEET_ENV="${HERMES_FLEET_ENV:-$HOME/.hermes/fleet.env}"
if [[ -f "$FLEET_ENV" ]]; then
  # shellcheck disable=SC1090
  source "$FLEET_ENV"
fi

HERMES_BIN="${HERMES_BIN:-${HERMES_FLEET_BIN:-}}"
# Fall back to the distributable config before the built-in last-resort path.
if [[ -z "$HERMES_BIN" ]]; then
  CONFIG="${HERMES_TEMPLATE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hermes-agent-template/config.toml}"
  if [[ -f "$CONFIG" ]] && command -v python3 >/dev/null 2>&1; then
    HERMES_BIN="$(python3 -c 'import sys,os,tomllib
try:
    d=tomllib.load(open(sys.argv[1],"rb"))
    print(os.path.expanduser(d.get("fleet",{}).get("hermes_bin","")),end="")
except Exception:
    pass' "$CONFIG" 2>/dev/null)"
  fi
fi
HERMES_BIN="${HERMES_BIN:-/home/delorenj/code/hermes-agent/.venv/bin/hermes}"

if [[ ! -d "$HERMES_HOME" ]]; then
  echo "hermes: runtime submodule not initialized at $HERMES_HOME" >&2
  echo "  fix: git submodule update --init --recursive" >&2
  exit 1
fi

if [[ ! -x "$HERMES_BIN" ]]; then
  echo "hermes: binary not executable at $HERMES_BIN" >&2
  echo "  set HERMES_BIN or HERMES_FLEET_BIN (in $FLEET_ENV) to the shared Hermes binary." >&2
  exit 1
fi

exec env HERMES_HOME="$HERMES_HOME" HERMES_FLEET_ENV="$FLEET_ENV" "$HERMES_BIN" "$@"
