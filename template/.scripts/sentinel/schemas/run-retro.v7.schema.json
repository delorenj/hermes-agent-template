{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.delo.sh/schemas/run-retro.v7.schema.json",
  "title": "Hermes durable post-loop retro artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "correlation_id",
    "repo",
    "provider",
    "source_issue",
    "local_tracking_reference",
    "decisions",
    "protected_evidence_refs",
    "sanitization",
    "operator_action_required",
    "routing"
  ],
  "properties": {
    "schema": {
      "const": "hermes.run-retro"
    },
    "schema_version": {
      "const": 7
    },
    "run_id": {
      "$ref": "#/$defs/rfcUuid"
    },
    "correlation_id": {
      "$ref": "#/$defs/rfcUuid"
    },
    "repo": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "provider": {
      "enum": [
        "linear",
        "plane",
        "trello"
      ]
    },
    "source_issue": {
      "oneOf": [
        {
          "$ref": "#/$defs/rfcUuid"
        },
        {
          "$ref": "#/$defs/trelloId"
        },
        {
          "type": "null"
        }
      ]
    },
    "local_tracking_reference": {
      "oneOf": [
        {
          "$ref": "#/$defs/rfcUuid"
        },
        {
          "$ref": "#/$defs/trelloId"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_hurt",
        "what_should_change",
        "fix_scope"
      ],
      "properties": {
        "what_hurt": {
          "$ref": "#/$defs/categorizedSummary"
        },
        "what_should_change": {
          "$ref": "#/$defs/categorizedSummary"
        },
        "fix_scope": {
          "enum": [
            "repo-local",
            "external",
            "template",
            "fleet"
          ]
        }
      }
    },
    "protected_evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "omitted_categories"
      ],
      "properties": {
        "status": {
          "const": "sanitized"
        },
        "omitted_categories": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "credentials",
              "tokens",
              "raw_logs",
              "customer_or_pii",
              "private_paths",
              "other_protected"
            ]
          }
        }
      }
    },
    "operator_action_required": {
      "type": "boolean"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error_category",
        "updated_at_epoch_us"
      ],
      "properties": {
        "status": {
          "enum": [
            "prepared",
            "posted",
            "already_present",
            "failed",
            "no_target_issue"
          ]
        },
        "error_category": {
          "oneOf": [
            {
              "enum": [
                "lookup_failed",
                "post_failed",
                "response_unknown",
                "serialization_failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at_epoch_us": {
          "$ref": "#/$defs/epochMicroseconds"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "enum": [
              "linear",
              "plane"
            ]
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "source_issue": {
            "oneOf": [
              {
                "$ref": "#/$defs/rfcUuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "local_tracking_reference": {
            "oneOf": [
              {
                "$ref": "#/$defs/rfcUuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "source_issue": {
            "oneOf": [
              {
                "$ref": "#/$defs/trelloId"
              },
              {
                "type": "null"
              }
            ]
          },
          "local_tracking_reference": {
            "oneOf": [
              {
                "$ref": "#/$defs/trelloId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_issue": {
            "type": "null"
          }
        },
        "required": [
          "source_issue"
        ]
      },
      "then": {
        "properties": {
          "operator_action_required": {
            "const": true
          },
          "routing": {
            "properties": {
              "status": {
                "enum": [
                  "prepared",
                  "no_target_issue"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "routing": {
            "properties": {
              "status": {
                "not": {
                  "const": "no_target_issue"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_issue": {
            "not": {
              "type": "null"
            }
          },
          "decisions": {
            "properties": {
              "fix_scope": {
                "const": "repo-local"
              }
            },
            "required": [
              "fix_scope"
            ]
          }
        },
        "required": [
          "source_issue",
          "decisions"
        ]
      },
      "then": {
        "properties": {
          "operator_action_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decisions": {
            "properties": {
              "fix_scope": {
                "enum": [
                  "external",
                  "template",
                  "fleet"
                ]
              }
            },
            "required": [
              "fix_scope"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "operator_action_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "routing": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "properties": {
              "error_category": {
                "enum": [
                  "lookup_failed",
                  "post_failed",
                  "response_unknown",
                  "serialization_failed"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "routing": {
            "properties": {
              "error_category": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "rfcUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "trelloId": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "epochMicroseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999999
    },
    "safeSummary": {
      "type": "string",
      "pattern": "^signal=(?:slow_feedback|manual_rework|flaky_validation|unclear_contract|missing_capability|dependency_delay|coordination_gap|environment_drift|documentation_gap|review_rework|no_material_friction|other_process_friction); action=(?:automate_check|clarify_contract|add_test|improve_tooling|update_documentation|isolate_dependency|tighten_review|improve_coordination|stabilize_environment|retain_current_process|operator_followup)$"
    },
    "categorizedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "summary"
      ],
      "properties": {
        "category": {
          "enum": [
            "process",
            "tooling",
            "dependency",
            "review",
            "testing",
            "coordination",
            "environment",
            "documentation",
            "automation",
            "external_dependency",
            "other"
          ]
        },
        "summary": {
          "$ref": "#/$defs/safeSummary"
        }
      }
    }
  }
}
