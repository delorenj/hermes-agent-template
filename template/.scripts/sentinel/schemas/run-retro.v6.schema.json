{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.delo.sh/schemas/run-retro.v6.schema.json",
  "title": "Hermes durable post-loop retro artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "artifact_fingerprint",
    "comment_fingerprint",
    "run_id",
    "correlation_id",
    "repo",
    "provider",
    "source_issue",
    "target_issue",
    "local_tracking_reference",
    "decisions",
    "protected_evidence_refs",
    "sanitization",
    "operator_action_required",
    "comment_fingerprint_marker",
    "comment_body",
    "recorded_at",
    "routing"
  ],
  "properties": {
    "schema": {
      "const": "hermes.run-retro"
    },
    "schema_version": {
      "const": 6
    },
    "artifact_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "comment_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "run_id": {
      "$ref": "#/$defs/invocation"
    },
    "correlation_id": {
      "$ref": "#/$defs/invocation"
    },
    "repo": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "provider": {
      "enum": [
        "linear",
        "plane",
        "trello"
      ]
    },
    "source_issue": {
      "oneOf": [
        {
          "$ref": "#/$defs/rfcUuid"
        },
        {
          "$ref": "#/$defs/trelloId"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_issue": {
      "oneOf": [
        {
          "$ref": "#/$defs/rfcUuid"
        },
        {
          "$ref": "#/$defs/trelloId"
        },
        {
          "type": "null"
        }
      ]
    },
    "local_tracking_reference": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_hurt",
        "what_should_change",
        "fix_scope"
      ],
      "properties": {
        "what_hurt": {
          "$ref": "#/$defs/categorizedSummary"
        },
        "what_should_change": {
          "$ref": "#/$defs/categorizedSummary"
        },
        "fix_scope": {
          "enum": [
            "repo-local",
            "external",
            "template",
            "fleet"
          ]
        }
      }
    },
    "protected_evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 300,
        "pattern": "^(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?:evidence:[A-Za-z0-9._:-]+|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "omitted_categories"
      ],
      "properties": {
        "status": {
          "const": "sanitized"
        },
        "omitted_categories": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "credentials",
              "tokens",
              "raw_logs",
              "customer_or_pii",
              "private_paths",
              "other_protected"
            ]
          }
        }
      }
    },
    "operator_action_required": {
      "type": "boolean"
    },
    "comment_fingerprint_marker": {
      "type": "string",
      "pattern": "^\\[run-retro-comment:[0-9a-f]{64}\\]$"
    },
    "comment_body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\n\\[run-retro-comment:[0-9a-f]{64}\\]$"
    },
    "recorded_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "error_category",
        "error_summary",
        "updated_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "prepared",
            "posted",
            "already_present",
            "failed",
            "no_target_issue"
          ]
        },
        "error_category": {
          "oneOf": [
            {
              "enum": [
                "lookup_failed",
                "post_failed",
                "response_unknown",
                "serialization_failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "error_summary": {
          "oneOf": [
            {
              "enum": [
                "comment lookup failed; no post attempted",
                "comment post failed; retry ensure_comment",
                "provider response not confirmed",
                "provider adapter unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "enum": [
              "linear",
              "plane"
            ]
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "source_issue": {
            "oneOf": [
              {
                "$ref": "#/$defs/rfcUuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_issue": {
            "oneOf": [
              {
                "$ref": "#/$defs/rfcUuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "source_issue": {
            "oneOf": [
              {
                "$ref": "#/$defs/trelloId"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_issue": {
            "oneOf": [
              {
                "$ref": "#/$defs/trelloId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_issue": {
            "type": "null"
          }
        },
        "required": [
          "source_issue"
        ]
      },
      "then": {
        "properties": {
          "target_issue": {
            "type": "null"
          },
          "operator_action_required": {
            "const": true
          },
          "routing": {
            "properties": {
              "status": {
                "enum": [
                  "prepared",
                  "no_target_issue"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target_issue": {
            "not": {
              "type": "null"
            }
          },
          "routing": {
            "properties": {
              "status": {
                "not": {
                  "const": "no_target_issue"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_issue": {
            "not": {
              "type": "null"
            }
          },
          "decisions": {
            "properties": {
              "fix_scope": {
                "const": "repo-local"
              }
            },
            "required": [
              "fix_scope"
            ]
          }
        },
        "required": [
          "source_issue",
          "decisions"
        ]
      },
      "then": {
        "properties": {
          "operator_action_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decisions": {
            "properties": {
              "fix_scope": {
                "enum": [
                  "external",
                  "template",
                  "fleet"
                ]
              }
            },
            "required": [
              "fix_scope"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "operator_action_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "routing": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "routing": {
            "oneOf": [
              {
                "properties": {
                  "error_category": {
                    "const": "lookup_failed"
                  },
                  "error_summary": {
                    "const": "comment lookup failed; no post attempted"
                  }
                }
              },
              {
                "properties": {
                  "error_category": {
                    "const": "post_failed"
                  },
                  "error_summary": {
                    "const": "comment post failed; retry ensure_comment"
                  }
                }
              },
              {
                "properties": {
                  "error_category": {
                    "const": "response_unknown"
                  },
                  "error_summary": {
                    "const": "provider response not confirmed"
                  }
                }
              },
              {
                "properties": {
                  "error_category": {
                    "const": "serialization_failed"
                  },
                  "error_summary": {
                    "const": "provider adapter unavailable"
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "routing": {
            "properties": {
              "error_category": {
                "type": "null"
              },
              "error_summary": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "invocation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "rfcUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "trelloId": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "safeSummary": {
      "type": "string",
      "pattern": "^signal=(?:slow_feedback|manual_rework|flaky_validation|unclear_contract|missing_capability|dependency_delay|coordination_gap|environment_drift|documentation_gap|review_rework|no_material_friction|other_process_friction); action=(?:automate_check|clarify_contract|add_test|improve_tooling|update_documentation|isolate_dependency|tighten_review|improve_coordination|stabilize_environment|retain_current_process|operator_followup)$"
    },
    "categorizedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "summary"
      ],
      "properties": {
        "category": {
          "enum": [
            "process",
            "tooling",
            "dependency",
            "review",
            "testing",
            "coordination",
            "environment",
            "documentation",
            "automation",
            "external_dependency",
            "other"
          ]
        },
        "summary": {
          "$ref": "#/$defs/safeSummary"
        }
      }
    }
  },
  "x-hermes-cross-field-invariants": [
    "source_issue and target_issue are byte-equal canonical IDs or both null",
    "artifact_fingerprint is the documented LF-terminated artifact preimage digest",
    "comment_fingerprint and marker are the documented LF-terminated comment preimage digest",
    "comment_body is the exact immutable body computed from decisions, operator_action_required, and marker",
    "only routing status, error_category, error_summary, and updated_at may change",
    "posted, already_present, and no_target_issue are terminal and cannot regress"
  ],
  "x-hermes-normalization": {
    "scalar": "Unicode NFKC, trim, reject control characters",
    "summary": "byte-equal closed ASCII signal/action vocabulary; arbitrary text is forbidden",
    "repository": "NFKC, trim, casefold, ASCII, then the repo pattern",
    "provider_issue_id": "NFKC, trim, casefold, provider pattern, then byte-equal canonical storage"
  },
  "x-hermes-immutable-json-pointers": [
    "/schema",
    "/schema_version",
    "/artifact_fingerprint",
    "/comment_fingerprint",
    "/run_id",
    "/correlation_id",
    "/repo",
    "/provider",
    "/source_issue",
    "/target_issue",
    "/local_tracking_reference",
    "/decisions",
    "/protected_evidence_refs",
    "/sanitization",
    "/operator_action_required",
    "/comment_fingerprint_marker",
    "/comment_body",
    "/recorded_at"
  ],
  "x-hermes-mutable-json-pointers": [
    "/routing/status",
    "/routing/error_category",
    "/routing/error_summary",
    "/routing/updated_at"
  ]
}
