# RETIRED 2026-10-26: scheduling moved to candybar (33GOD/candybar deploy/migration/ledger.yaml,
# id systemd:hermes-single-install-guard.timer). Kept for rollback only — never enable this timer.
[Unit]
Description=Hermes drift guard, every 15 minutes

[Timer]
OnBootSec=2min
# OnActiveSec re-arms the timer after a reboot: with Persistent=true, an elapsed OnBootSec plus
# OnUnitActiveSec and no prior run leaves NextElapse=infinity (timer 'active (elapsed)' forever).
OnActiveSec=2min
OnUnitActiveSec=15min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
